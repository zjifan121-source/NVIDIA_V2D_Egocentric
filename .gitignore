# Team rules for the whole repo. NVIDIA's own rules live in baseline/.gitignore
# and baseline/<package>/.gitignore.

# Local inputs (Track 3 dataset, other downloads). Weights and run outputs live in
# baseline/reconstruction/data/, which NVIDIA's baseline/reconstruction/.gitignore covers.
/assets/data/

# OS / editor / Python
.DS_Store
*.code-workspace
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Never commit: secrets, licensed models, large artifacts
.env
MANO_RIGHT.pkl
third_party/
*.pt
*.pth
*.ckpt
*.npz
